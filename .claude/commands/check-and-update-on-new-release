#!/bin/bash

# check-and-update-on-new-release - alias for auto-update-on-release
# Use after merging a PR: runs docker compose down once if a new release was published, then exits.
#
# Examples:
# .claude/commands/check-and-update-on-new-release
# .claude/commands/check-and-update-on-new-release --dry-run

exec "$(dirname "$0")/auto-update-on-release" "$@"