# Environment variables for Twitter Bulk Blocker.
# The tool does not read .env itself: copy this file to .env and load it into the environment first:
#   set -a; source .env; set +a
# Command-line options (--cookies, --users-file, --db, --cache-dir) take precedence.

# Path to the cookie file exported from a logged-in x.com session
TWITTER_COOKIES_PATH=cookies.json

# Path to the users file listing the accounts to block
TWITTER_USERS_FILE=video_misuse_detecteds.json

# Path to the SQLite block-history database
TWITTER_BLOCK_DB=block_history.db

# Directory for the API cache (the built-in default /data/cache is meant for Docker)
CACHE_DIR=./cache
